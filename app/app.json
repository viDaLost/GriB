{
  "expo": {
    "name": "Грибник",
    "slug": "gribnik",
    "scheme": "gribnik",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.gribnik.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать гриб и определить его вид."
      }
    },
    "android": {
      "package": "ru.gribnik.app",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#023B19",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "name": "Грибник",
      "shortName": "Грибник",
      "lang": "ru",
      "themeColor": "#234F40",
      "backgroundColor": "#F7F4EC"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен, чтобы определить гриб по снимку из галереи.",
          "cameraPermission": "Камера нужна, чтобы сфотографировать гриб и определить его вид.",
          "microphonePermission": false
        }
      ],
      "react-native-fast-tflite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Геолокация нужна, чтобы сохранить место находки гриба на карте."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#023B19"
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/GriB"
    }
  }
}
